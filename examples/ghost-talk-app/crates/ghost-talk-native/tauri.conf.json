{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Talk",
  "version": "0.1.0",
  "identifier": "org.ghosttalk.app",
  "build": {
    "frontendDist": "../../../../target/build/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost Talk",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
